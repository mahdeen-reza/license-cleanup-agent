# Database (required)
DATABASE_URL=postgresql://user:password@db:5432/license_cleanup
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=license_cleanup
NODE_ENV=production

# AI Provider (optional — app runs with mock fallback if absent)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Auth — secret used to sign session tokens (change in production!)
TOKEN_SECRET=change-this-to-a-random-secret

# Local dev only
DEV_USER_EMAIL=dev@company.com

# ─── Render Deployment ────────────────────────────────────────────────────────
# On Render, these are set automatically via render.yaml:
#   DATABASE_URL  — injected from the linked PostgreSQL instance
#   TOKEN_SECRET  — auto-generated random value
#   PORT          — injected by Render (do NOT set manually)
#
# Free tier notes:
#   - Web service spins down after 15 min inactivity (~30s cold start)
#   - PostgreSQL expires after 90 days — recreate via Render dashboard
#   - Without ANTHROPIC_API_KEY, chat returns informational messages;
#     analysis runs use deterministic classification (all → Human Review)
